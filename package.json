{
  "private": true,
  "type": "module",
  "description": "Modular framework to teach Puppeteer new tricks.",
  "repository": "zorillajs/zorilla",
  "authors": [
    "berstend",
    "Justin Beckwith <justin.beckwith@gmail.com>"
  ],
  "license": "MIT",
  "main": "packages/puppeteer-extra/index.js",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r --workspace-concurrency=1 run build",
    "test": "pnpm -r --workspace-concurrency=1 run test",
    "prepare": "pnpm -r run prepare",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "pnpm build && changeset publish",
    "fix": "biome check --write .",
    "check": "biome check .",
    "links": "linkinator \"**/*.md\" --config linkinator.config.json",
    "links:ci": "linkinator \"**/*.md\" --config linkinator.config.json"
  },
  "workspaces": [
    "packages/*"
  ],
  "devDependencies": {
    "@biomejs/biome": "^2.3.11",
    "@changesets/changelog-github": "^0.5.2",
    "@changesets/cli": "^2.29.8",
    "@vitest/coverage-v8": "^4.0.17",
    "linkinator": "^7.1.1",
    "typescript": "^5.9.3"
  },
  "pnpm": {
    "overrides": {
      "fsevents": "^2.1.2"
    }
  },
  "version": "0.0.0"
}
