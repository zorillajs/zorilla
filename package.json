{
  "private": true,
  "type": "module",
  "description": "Modular framework to teach Puppeteer new tricks.",
  "repository": "zorillajs/zorilla",
  "authors": [
    "berstend",
    "Justin Beckwith <justin.beckwith@gmail.com>"
  ],
  "license": "MIT",
  "main": "packages/puppeteer-extra/index.js",
  "engines": {
    "node": ">=22",
    "pnpm": "<12"
  },
  "scripts": {
    "build": "pnpm -r --workspace-concurrency=1 run build",
    "test": "pnpm -r --workspace-concurrency=1 run test",
    "test:pnpm-consumer": "node scripts/test-pnpm-consumer.mjs",
    "prepare": "pnpm -r --if-present run prepare",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "pnpm build && changeset publish",
    "fix": "biome check --write .",
    "check": "biome check .",
    "renovate:validate": "pnpm --package=renovate@43.214.2 dlx renovate-config-validator --strict --no-global renovate.json",
    "links": "linkinator \"**/*.md\" --config linkinator.config.json"
  },
  "workspaces": [
    "packages/*"
  ],
  "devDependencies": {
    "@biomejs/biome": "^2.3.11",
    "@changesets/changelog-github": "^1.0.0",
    "@changesets/cli": "^3.0.0",
    "@vitest/coverage-v8": "^4.1.2",
    "linkinator": "^8.0.0",
    "typescript": "^7.0.0"
  },
  "version": "0.0.0"
}
