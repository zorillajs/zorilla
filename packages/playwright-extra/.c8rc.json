{
  "all": true,
  "src": "./dist",
  "include": ["dist/**/*.js"],
  "exclude": ["dist/**/*.d.ts", "**/*.spec.ts", "**/test/**", "**/fixtures/**"],
  "reporter": ["text", "json", "html"],
  "reports-dir": "./coverage",
  "check-coverage": true,
  "lines": 100,
  "functions": 100,
  "branches": 100,
  "statements": 100
}
