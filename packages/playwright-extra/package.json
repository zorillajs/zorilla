{
  "name": "@zorilla/playwright-extra",
  "version": "1.0.2",
  "description": "Teach playwright new tricks through plugins.",
  "repository": "zorillajs/zorilla",
  "homepage": "https://github.com/zorillajs/zorilla/tree/main/packages/playwright-extra#readme",
  "authors": [
    "berstend",
    "Justin Beckwith <justin.beckwith@gmail.com>"
  ],
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "rm -rf dist coverage",
    "build": "tsc",
    "test": "playwright test --config test/playwright.config.ts",
    "test:coverage": "NODE_V8_COVERAGE=coverage playwright test --config test/playwright.config.ts && c8 report"
  },
  "keywords": [
    "playwright",
    "playwright-extra",
    "stealth",
    "recaptcha",
    "user-preferences",
    "chrome",
    "headless",
    "pupeteer"
  ],
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@types/debug": "^4.1.12",
    "@types/node": "^24.10.9",
    "@zorilla/puppeteer-extra-plugin": "workspace:*",
    "@zorilla/puppeteer-extra-plugin-anonymize-ua": "workspace:*",
    "@zorilla/puppeteer-extra-plugin-recaptcha": "workspace:*",
    "@zorilla/puppeteer-extra-plugin-stealth": "workspace:*",
    "@zorilla/puppeteer-extra-plugin-user-data-dir": "workspace:*",
    "@zorilla/puppeteer-extra-plugin-user-preferences": "workspace:*",
    "c8": "^11.0.0",
    "playwright": "^1.58.0",
    "typescript": "6.0.2"
  },
  "dependencies": {
    "debug": "^4.4.3"
  },
  "peerDependencies": {
    "playwright": "*",
    "playwright-core": "*"
  },
  "peerDependenciesMeta": {
    "playwright": {
      "optional": true
    },
    "playwright-core": {
      "optional": true
    }
  }
}
