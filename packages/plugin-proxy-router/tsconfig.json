{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM"],
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "strict": false,
    "noImplicitReturns": false,
    "noUnusedLocals": true,
    "noUnusedParameters": false,
    "stripInternal": true,
    "types": ["node"],
    "outDir": "./dist",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true
  },
  "include": ["./src/**/*.tsx", "./src/**/*.ts", "./src/**/*.d.ts"],
  "exclude": [
    "node_modules",
    "dist",
    "./src/**/*.test.ts",
    "./test/**/*.ts",
    "./test/**/*.spec.ts"
  ]
}
