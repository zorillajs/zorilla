{
  "name": "@zorilla/puppeteer-extra-plugin-adblocker",
  "version": "1.0.1",
  "description": "A puppeteer-extra plugin to block ads and trackers.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "repository": "zorillajs/zorilla",
  "homepage": "https://github.com/zorillajs/zorilla/tree/main/packages/puppeteer-extra-plugin-adblocker",
  "authors": [
    "remusao",
    "Justin Beckwith <justin.beckwith@gmail.com>"
  ],
  "license": "MIT",
  "scripts": {
    "clean": "rm -rf dist",
    "tscheck": "tsc --pretty --noEmit",
    "build": "tsc && node build_version_check.js",
    "test": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "puppeteer",
    "puppeteer-extra",
    "puppeteer-extra-plugin",
    "ads",
    "adblocker",
    "adblocking"
  ],
  "devDependencies": {
    "@types/debug": "^4.1.12",
    "@types/node": "^24.10.9",
    "@vitest/coverage-v8": "^4.1.2",
    "@zorilla/puppeteer-extra": "workspace:*",
    "puppeteer": "^24.40.0",
    "typescript": "6.0.2",
    "vitest": "^4.1.2"
  },
  "dependencies": {
    "@cliqz/adblocker-puppeteer": "1.34.0",
    "@zorilla/puppeteer-extra-plugin": "workspace:*",
    "debug": "^4.4.3"
  },
  "peerDependencies": {
    "puppeteer": "*",
    "puppeteer-core": "*",
    "puppeteer-extra": "*"
  },
  "peerDependenciesMeta": {
    "puppeteer": {
      "optional": true
    },
    "puppeteer-core": {
      "optional": true
    },
    "puppeteer-extra": {
      "optional": true
    }
  }
}
