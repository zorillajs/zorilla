{
  "name": "@zorilla/puppeteer-extra-plugin-recaptcha",
  "version": "1.0.1",
  "description": "A puppeteer-extra plugin to solve reCAPTCHAs and hCaptchas automatically.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "repository": "zorillajs/zorilla",
  "homepage": "https://github.com/zorillajs/zorilla/tree/main/packages/puppeteer-extra-plugin-recaptcha",
  "authors": [
    "berstend",
    "Justin Beckwith <justin.beckwith@gmail.com>"
  ],
  "license": "MIT",
  "scripts": {
    "clean": "rm -rf dist",
    "tscheck": "tsc --pretty --noEmit",
    "build": "tsc",
    "test": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "puppeteer",
    "puppeteer-extra",
    "puppeteer-extra-plugin",
    "recaptcha",
    "hcaptcha",
    "captcha",
    "2captcha"
  ],
  "devDependencies": {
    "@types/debug": "^4.1.12",
    "@types/node": "25.0.10",
    "@vitest/coverage-v8": "^4.0.17",
    "puppeteer": "^24.35.0",
    "puppeteer-extra": "^3.3.6",
    "typescript": "5.9.3",
    "vitest": "^4.0.17"
  },
  "dependencies": {
    "debug": "^4.4.3",
    "merge-deep": "^3.0.3",
    "@zorilla/puppeteer-extra-plugin": "workspace:*"
  },
  "peerDependencies": {
    "playwright-extra": "*",
    "puppeteer-extra": "*"
  },
  "peerDependenciesMeta": {
    "puppeteer-extra": {
      "optional": true
    },
    "playwright-extra": {
      "optional": true
    }
  }
}
