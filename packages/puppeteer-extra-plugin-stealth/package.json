{
  "name": "@zorilla/puppeteer-extra-plugin-stealth",
  "version": "1.0.2",
  "description": "Stealth mode: Applies various techniques to make detection of headless puppeteer harder.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./evasions/*": "./dist/evasions/*/index.js"
  },
  "repository": "zorillajs/zorilla",
  "homepage": "https://github.com/zorillajs/zorilla/tree/main/packages/puppeteer-extra-plugin-stealth#readme",
  "authors": [
    "berstend",
    "Justin Beckwith <justin.beckwith@gmail.com>"
  ],
  "license": "MIT",
  "scripts": {
    "build": "tsc && node scripts/fix-imports.js",
    "typecheck": "tsc --project tsconfig.test.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint --ext .js,.ts ."
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "puppeteer",
    "puppeteer-extra",
    "puppeteer-extra-plugin",
    "stealth",
    "stealth-mode",
    "detection-evasion",
    "crawler",
    "chrome",
    "headless",
    "pupeteer"
  ],
  "devDependencies": {
    "@types/node": "^24.10.9",
    "@zorilla/puppeteer-extra": "workspace:*",
    "fpcollect": "^1.0.5",
    "fpscanner": "^1.0.2",
    "loop": "^3.3.6",
    "puppeteer": "^24.40.0",
    "vitest": "^4.1.2"
  },
  "dependencies": {
    "@zorilla/puppeteer-extra-plugin": "workspace:*",
    "@zorilla/puppeteer-extra-plugin-user-preferences": "workspace:*",
    "debug": "^4.4.3"
  },
  "peerDependencies": {
    "playwright-extra": "*",
    "puppeteer-extra": "*"
  },
  "peerDependenciesMeta": {
    "puppeteer-extra": {
      "optional": true
    },
    "playwright-extra": {
      "optional": true
    }
  }
}
