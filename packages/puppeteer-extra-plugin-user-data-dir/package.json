{
  "name": "@zorilla/puppeteer-extra-plugin-user-data-dir",
  "version": "2.0.0",
  "description": "Custom user data directory for puppeteer.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "repository": "zorillajs/zorilla",
  "homepage": "https://github.com/zorillajs/zorilla/tree/main/packages/puppeteer-extra-plugin-user-data-dir",
  "authors": [
    "berstend",
