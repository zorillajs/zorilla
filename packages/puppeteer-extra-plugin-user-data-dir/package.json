  "dependencies": {
    "@zorilla/puppeteer-extra-plugin": "workspace:*",
    "debug": "^4.4.3"
  },
  "peerDependencies": {
    "@zorilla/playwright-extra": "^2.0.0",
    "@zorilla/puppeteer-extra": "^2.0.0"
