{
  "name": "@zorilla/puppeteer-extra-plugin-user-preferences",
  "version": "1.0.1",
  "description": "Launch puppeteer with arbitrary user preferences.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "repository": "zorillajs/zorilla",
  "homepage": "https://github.com/zorillajs/zorilla/tree/main/packages/puppeteer-extra-plugin-user-preferences",
  "authors": [
    "berstend",
    "Justin Beckwith <justin.beckwith@gmail.com>"
  ],
  "license": "MIT",
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "puppeteer",
    "puppeteer-extra",
    "puppeteer-extra-plugin",
    "user-prefs",
    "user-preferences",
    "chrome",
    "headless",
    "pupeteer"
  ],
  "devDependencies": {
    "@types/debug": "^4.1.12",
    "@types/node": "^24.10.9",
    "@vitest/coverage-v8": "^4.1.2",
    "@zorilla/puppeteer-extra": "workspace:*",
    "puppeteer": "^24.40.0",
    "vitest": "^4.1.2"
  },
  "dependencies": {
    "@zorilla/puppeteer-extra-plugin": "workspace:*",
    "@zorilla/puppeteer-extra-plugin-user-data-dir": "workspace:*",
    "debug": "^4.4.3",
    "deepmerge": "^4.3.1"
  },
  "peerDependencies": {
    "playwright-extra": "*",
    "puppeteer-extra": "*"
  },
  "peerDependenciesMeta": {
    "puppeteer-extra": {
      "optional": true
    },
    "playwright-extra": {
      "optional": true
    }
  }
}
