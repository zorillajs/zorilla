    "typescript": "^5.9.3",
    "vitest": "^4.0.17"
  },
  "dependencies": {
    "@types/debug": "^4.1.12",
    "debug": "^4.4.3",
    "merge-deep": "^3.0.3"
  },
  "peerDependencies": {
