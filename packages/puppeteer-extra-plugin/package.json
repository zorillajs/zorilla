{
  "name": "@zorilla/puppeteer-extra-plugin",
  "version": "1.0.2",
  "type": "module",
  "description": "Base class for puppeteer-extra plugins.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./puppeteer": {
      "import": "./dist/puppeteer.js",
      "types": "./dist/puppeteer.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "repository": "zorillajs/zorilla",
  "homepage": "https://github.com/zorillajs/zorilla/tree/main/packages/puppeteer-extra-plugin",
  "authors": [
    "berstend",
    "Justin Beckwith <justin.beckwith@gmail.com>"
  ],
  "license": "MIT",
  "scripts": {
    "clean": "rm -rf dist",
    "build": "tsc",
    "test": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "puppeteer",
    "puppeteer-extra",
    "puppeteer-extra-plugin",
    "ua",
    "user-agent",
    "chrome",
    "headless",
    "pupeteer"
  ],
  "devDependencies": {
    "@babel/core": "^7.28.6",
    "@types/node": "^24.10.9",
    "@vitest/coverage-v8": "^4.1.2",
    "puppeteer": "^24.40.0",
    "typescript": "^6.0.2",
    "vitest": "^4.1.2"
  },
  "dependencies": {
    "@types/debug": "^4.1.12",
    "debug": "^4.4.3",
    "merge-deep": "^3.0.3"
  },
  "peerDependencies": {
    "playwright-extra": "*",
    "puppeteer-extra": "*"
  },
  "peerDependenciesMeta": {
    "puppeteer-extra": {
      "optional": true
    },
    "playwright-extra": {
      "optional": true
    }
  }
}
