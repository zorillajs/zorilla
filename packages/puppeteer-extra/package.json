{
  "name": "@zorilla/puppeteer-extra",
  "version": "1.0.0",
  "type": "module",
  "description": "Teach puppeteer new tricks through plugins.",
  "repository": "zorillajs/zorilla",
  "homepage": "https://github.com/zorillajs/zorilla/tree/main/packages/puppeteer-extra",
  "authors": [
    "berstend",
    "Justin Beckwith <justin.beckwith@gmail.com>"
  ],
  "license": "MIT",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "rm -rf dist",
    "build": "tsc",
    "test": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "keywords": [
    "puppeteer",
    "puppeteer-extra",
    "flash",
    "stealth",
    "prefs",
    "user-preferences",
    "chrome",
    "headless",
    "pupeteer"
  ],
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^25.0.6",
    "@vitest/coverage-v8": "^4.0.17",
    "@zorilla/puppeteer-extra-plugin": "workspace:*",
    "puppeteer": "^24.35.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.17"
  },
  "dependencies": {
    "@types/debug": "^4.1.12",
    "debug": "^4.4.3",
    "deepmerge": "^4.3.1"
  },
  "peerDependencies": {
    "puppeteer": "*",
    "puppeteer-core": "*"
  },
  "peerDependenciesMeta": {
    "puppeteer": {
      "optional": true
    },
    "puppeteer-core": {
      "optional": true
    }
  }
}
