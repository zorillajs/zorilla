{
  "name": "@zorilla/stealth-tests",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Deterministic stealth conformance probes and reports for Zorilla",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:conformance": "node dist/conformance.js",
    "test:coverage": "vitest run --coverage"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@types/node": "^24.10.9",
    "@vitest/coverage-v8": "^4.1.2",
    "@zorilla/playwright-extra": "workspace:*",
    "@zorilla/puppeteer-extra": "workspace:*",
    "@zorilla/puppeteer-extra-plugin-stealth": "workspace:*",
    "playwright": "^1.59.1",
    "puppeteer": "^25.0.0",
    "typescript": "^7.0.0",
    "vitest": "^4.1.2"
  }
}
