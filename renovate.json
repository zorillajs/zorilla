{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:base", ":disableDependencyDashboard"],
  "pinVersions": false,
  "rebaseStalePrs": true,
  "packageRules": [
    {
      "groupName": "playwright monorepo",
      "matchPackagePatterns": ["^playwright$", "^@playwright/"]
    }
  ]
}
