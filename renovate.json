{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:base",
    ":disableDependencyDashboard",
    "helpers:pinGitHubActionDigestsToSemver"
  ],
  "pinVersions": false,
  "rebaseStalePrs": true,
  "vulnerabilityAlerts": {
    "enabled": true,
    "automerge": true
  },
  "packageRules": [
    {
      "groupName": "playwright monorepo",
      "matchPackagePatterns": ["^playwright", "^@playwright/"]
    }
  ]
}
